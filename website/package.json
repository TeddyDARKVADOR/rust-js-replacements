  "dependencies": {
    "@rust-js-replacements/string-width": "workspace:*",
    "@rust-js-replacements/wrap-ansi": "workspace:*",
    "string-width": "9.0.0",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
