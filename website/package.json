{
  "name": "website",
  "private": true,
  "description": "Catalog website: one page per library with installation, results, and a live playground.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check:catalog": "node scripts/check-catalog.ts",
    "dev": "vite",
